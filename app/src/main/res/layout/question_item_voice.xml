<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_question_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quiz_badge_bg"
                android:fontFamily="@font/product_sans"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/quiz_type_voice"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/product_sans"
                android:textColor="@color/txt_color_secondary"
                android:textSize="13sp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_stem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/txt_color"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_audio_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/quiz_text_bg"
            android:fontFamily="@font/product_sans"
            android:padding="12dp"
            android:textColor="@color/txt_color"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_record"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/quiz_record_btn_bg"
                android:contentDescription="@string/quiz_record"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_microphone"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recording_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans"
                    android:text="@string/quiz_tap_to_record"
                    android:textColor="@color/txt_color"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_recording_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans"
                    android:text="00:00"
                    android:textColor="@color/txt_color_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_playback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/quiz_playback_bg"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_bg"
                android:contentDescription="@string/quiz_play"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_play"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_playback_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/product_sans"
                android:text="@string/quiz_recording_ready"
                android:textColor="@color/txt_color"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_delete_recording"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_bg"
                android:contentDescription="@string/quiz_delete_recording"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_delete"
                app:tint="@color/colorAccent" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
